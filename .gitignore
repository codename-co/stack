.DS_Store
*.cer
*.pem
*.stack
node_modules
/packages/website/public/releases
/work/

# The app bundles these as Tauri resources (see bundle.resources in
# tauri.conf.json), so they must be in the repo or CI cannot build.
!packages/app/src-tauri/extra/*.stack

# TLS material for the local API is generated per-install at first launch and
# stored in the app data directory. Nothing under certs/ is bundled or tracked.
packages/app/src-tauri/certs/

# Never commit signing material or credentials.
.env
*.p12
*.key
