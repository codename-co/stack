---
import { getCollection } from "astro:content";
import { marked } from "marked";
import { Aurora, GlassCard } from "performative-ui";
import EnvironmentVars from "~/components/EnvironmentVars";
import StackActions from "~/components/StackActions.astro";
import StackHero from "~/components/StackHero.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import { getStacks } from "~/content/collections/stacks";
import { langs, useTranslations, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";
import { brandGlowOf } from "~/helpers";
import Card from "~components/Card";
import Cards from "~components/Cards";

export const getStaticPaths = async () => {
  return langs
    .map((lang) =>
      getStacks(lang).map(({ data }) => ({ params: { lang, slug: data.slug } }))
    )
    .flat();
};

const slug = Astro.params.slug;
if (!slug) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return new Response("Missing parameter", { status: 404 });
}

const lang = Astro.params.lang;
const t = useTranslations(lang);
const url = useUrl(lang);

const stacks = getStacks(lang);

const stack = stacks.find((stack) => stack.data.slug === slug)?.data;
if (!stack) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return new Response("Not found", { status: 404 });
}

const {
  name,
  description,
  version,
  updated_at,
  tags: _tags,
  readme,
  env,
  alternativeTo,
} = stack;

const similar = Array.from(
  new Set(
    [
      ...stacks.filter(
        (candidate) =>
          candidate.data.slug !== slug &&
          // ensure both alternativeTo and candidate.alternativeTo have an intersection
          (alternativeTo || []).some((slug) =>
            candidate.data.alternativeTo?.includes(slug)
          )
      ),
      ...stacks.filter(
        (candidate) =>
          candidate.data.slug !== slug &&
          // ensure both tags and candidate.tags have an intersection
          (_tags || []).some((tag) => candidate.data.tags?.includes(tag))
      ),
    ].map((entry) => entry.data.slug)
  )
)
  // Six, not five: the grid below is 2 or 3 columns wide, and a dangling
  // half-empty row reads as "we ran out" rather than "here is a set".
  .slice(0, 6)
  .map((slug) => stacks.find((stack) => stack.data.slug === slug)?.data);

// Only needed for the closing CTA's halo; the hero derives its own.
const brandGlow = brandGlowOf(slug);

const envCount = Object.keys(env ?? {}).length;
---

<Layout
  lang={lang}
  title={`${name} stack`}
  description={description}
  leftTransition="fade"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@id": [slug, lang].filter(Boolean).join("-"),
      "@type": "SoftwareApplication",
      name,
      url: new URL(Astro.url.pathname, Astro.site),
      softwareVersion: version,
      headline: name,
      description,
      // about: description,
      // screenshot: "[image-url]",
      image: {
        "@type": "ImageObject",
        url: readme?.match(/!\[.*\]\((.*)\)/)?.[1],
      },
      applicationCategory: "BrowserApplication",
      // applicationSubCategory: "Product Comparison",
      inLanguage: lang,
      operatingSystem: "Web Browser",
      browserRequirements: "Requires Stack Desktop",
      dateModified: new Date(updated_at ?? "").toISOString(),
      // aggregateRating: {
      //   "@type": "AggregateRating",
      //   ratingValue: 4.7,
      //   ratingCount: stars,
      // },
      downloadUrl: new URL(url(`/downloads/${slug}.stack`), Astro.site),
    })}
  />

  <div slot="left">
    <StackHero lang={lang} stack={stack}>
      <StackActions
        lang={lang}
        runHref={url(`/${slug}.stack`)}
        fileHref={`/downloads/${slug}.stack`}
      />
      <p
        class="subtle text-xs !mt-3 !mb-0"
        set:html={t("Runs locally, in one click.")}
      />
    </StackHero>
  </div>

  <div class="section">
    <div class="container">
      <SectionHeading title={t("About *{name}*", { name })} />
      <GlassCard glowOnHover={false} className="content stack-readme">
        {
          readme ? (
            <Fragment set:html={marked.parse(readme)} />
          ) : (
            <p class="subtle">{t("No description provided.")}</p>
          )
        }
      </GlassCard>
    </div>
  </div>

  <!-- {
    envCount > 0 && (
      <div class="section">
        <div class="container">
          <SectionHeading
            title={t("Environment variables")}
            subtitle={t("{count} variables you can tune before starting.", {
              count: envCount,
            })}
          />
          {/* Capped: the IDE chrome is the darkest, highest-contrast block on
              the page, and at full container width it out-shouts both the
              README above it and the CTA below. */}
          <div class="max-w-3xl">
            <EnvironmentVars lang={lang} env={env} />
          </div>
        </div>
      </div>
    )
  } -->

  <div slot="right">
    {
      similar.length > 0 && (
        <div class="section">
          <div class="container">
            <SectionHeading title={t("Related")} />
            <Cards className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
              {similar
                .map((e) => e as any)
                .map(({ slug, name, icon, description, stars }) => (
                  <li class="inline-flex pt-2">
                    <Card
                      small
                      lang={lang}
                      slug={slug}
                      name={name}
                      description={description}
                      url={url(`/${slug}`)}
                      icon={icon}
                      stars={stars}
                    />
                  </li>
                ))}
            </Cards>
          </div>
        </div>
      )
    }

    {/* A reader who made it past the README has finished evaluating; give them
        the action again rather than the footer. */}
    <div class="section relative overflow-hidden mb-0">
      <div class="container">
        <div
          class="relative flex flex-col items-center gap-6 text-center py-16 rounded-pui-xl overflow-hidden"
        >
          <Aurora blobs={[{ color: brandGlow, x: 50, y: 90, size: 60 }]} />
          <h2
            class="relative z-10 m-0"
            set:html={t("Ready to run *{name}*?", { name })}
          />
          <div class="relative z-10">
            <StackActions
              lang={lang}
              runHref={url(`/${slug}.stack`)}
              fileHref={`/downloads/${slug}.stack`}
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* READMEs are written for a repository page, where the first thing is
       usually a full-bleed screenshot. Unconstrained, it pushed the actual
       feature list a full viewport below the fold.

       The global `.content img` rule forces `width: 100%`, which is what made
       capping the height letterbox the image instead of shrinking it, so the
       width goes back to intrinsic here. */
    .stack-readme :global(img) {
      width: auto;
      max-width: 100%;
      max-height: 22rem;
      height: auto;
      border: 1px solid var(--pui-border);
    }
    /* Prose measure. The card is as wide as the page; running text should not
       be. Tables, images and code keep the full width. */
    .stack-readme :global(p),
    .stack-readme :global(li) {
      max-width: 72ch;
    }
  </style>
</Layout>
