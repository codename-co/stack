---
import { marked } from "marked";
import { Aurora, GlassCard } from "performative-ui";
import Logo from "~/components/Logo";
import SectionHeading from "~/components/SectionHeading.astro";
import StackActions from "~/components/StackActions.astro";
import StackHero from "~/components/StackHero.astro";
import { getRecipes } from "~/content/collections/recipes";
import { getStacks } from "~/content/collections/stacks";
import { langs, useTranslations, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";
import { brandGlowOf, brandOf, formatStars, hasLogoOf } from "~/helpers";
import Cards from "~components/Cards";
import Card from "~components/Card";

export const getStaticPaths = async () => {
  return langs
    .map((lang) =>
      getRecipes(lang).map(({ data }) => ({
        params: { lang, slug: data.slug },
      }))
    )
    .flat();
};

const slug = Astro.params.slug;
if (!slug) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return new Response("Missing parameter", { status: 404 });
}

const lang = Astro.params.lang;
const t = useTranslations(lang);
const url = useUrl(lang);

const recipes = getRecipes(lang);
const stacks = getStacks(lang);

const recipe = recipes.find((recipe) => recipe.data.slug === slug)?.data;
if (!recipe) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return new Response("Not found", { status: 404 });
}

const {
  name,
  description,
  icon,
  updated_at,
  readme,
  alternativeTo,
  dependencies,
} = recipe;

const associatedStacks =
  dependencies?.map(({ name, icon, role, custom }) => ({
    custom,
    role,
    ...(custom && {
      name,
      slug: name.toLowerCase(),
      icon: icon ?? name.toLowerCase(),
    }),
    ...(!custom && stacks.find((stack) => stack.data.slug === name)?.data),
  })) ?? [];

const similar = Array.from(
  new Set(
    [
      ...recipes.filter(
        (candidate) =>
          candidate.data.slug !== slug &&
          // ensure both alternativeTo and candidate.alternativeTo have an intersection
          (alternativeTo || []).some((slug) =>
            candidate.data.alternativeTo?.includes(slug)
          )
      ),
    ].map((entry) => entry.data.slug)
  )
)
  .slice(0, 6)
  .map((slug) => recipes.find((recipe) => recipe.data.slug === slug)?.data);

// Only needed for the closing CTA's halo; the hero derives its own.
const brandGlow = brandGlowOf(slug, icon);
---

<Layout
  lang={lang}
  title={`${name} recipe`}
  description={description}
  leftTransition="fade"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@id": [slug, lang].filter(Boolean).join("-"),
      "@type": "SoftwareApplication",
      name,
      url: new URL(Astro.url.pathname, Astro.site),
      headline: name,
      description,
      image: {
        "@type": "ImageObject",
        url: readme?.match(/!\[.*\]\((.*)\)/)?.[1],
      },
      applicationCategory: "BrowserApplication",
      inLanguage: lang,
      operatingSystem: "Web Browser",
      browserRequirements: "Requires Stack Desktop",
      dateModified: new Date(updated_at ?? "").toISOString(),
    })}
  />

  <div slot="left">
    <StackHero lang={lang} stack={recipe} eyebrow={t("Recipe")}>
      <StackActions
        lang={lang}
        runHref={url(`/recipes/${slug}.stack`)}
        fileHref={`/downloads/recipes/${slug}.stack`}
      />
      <p
        class="subtle text-xs !mt-3 !mb-0"
        set:html={t("Runs locally, in one click.")}
      />
    </StackHero>
  </div>

  {
    associatedStacks.length > 0 && (
      <div class="section">
        <div class="container">
          <SectionHeading
            title={t("Recipe ingredients")}
            subtitle={t(
              "{count} services, wired together and started as one.",
              { count: associatedStacks.length }
            )}
          />
          {/*
            Was a `<table>` with `border-spacing-4` where the name cell held an
            `<h4>`, a star count and a licence, and the role sat in an
            unlabelled second column. A recipe's ingredients are a set of
            things, not a data table — and the role is the interesting part, so
            it gets the body text rather than a bare cell.
          */}
          <ul class="stack-ingredients">
            {associatedStacks.map((dep: any) => {
              const inner = (
                <>
                  <span
                    class="stack-ingredients__icon"
                    style={{ "--brand": brandOf(dep.slug, dep.icon) }}
                    aria-hidden="true"
                  >
                    {hasLogoOf(dep.slug, dep.icon) ? (
                      <Logo slug={dep.slug} icon={dep.icon} />
                    ) : (
                      <span class="stack-ingredients__monogram">
                        {(dep.name ?? "?").slice(0, 1).toUpperCase()}
                      </span>
                    )}
                  </span>
                  <span class="min-w-0">
                    <span class="stack-ingredients__name">
                      {dep.name}
                      {dep.stars && (
                        <small class="subtle font-normal ms-2">
                          ★&nbsp;{formatStars(dep.stars, lang)}
                        </small>
                      )}
                    </span>
                    {dep.role && (
                      <span class="stack-ingredients__role">{dep.role}</span>
                    )}
                  </span>
                </>
              );

              return (
                <li>
                  {/* Custom ingredients are declared inline by the recipe and
                      have no catalog page to link to. */}
                  {dep.custom ? (
                    <span class="stack-ingredients__item">{inner}</span>
                  ) : (
                    <a class="stack-ingredients__item" href={url(`/${dep.slug}`)}>
                      {inner}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    )
  }

  <div class="section">
    <div class="container">
      <SectionHeading title={t("About *{name}*", { name })} />
      <GlassCard glowOnHover={false} className="content stack-readme">
        {
          readme ? (
            <Fragment set:html={marked.parse(readme)} />
          ) : (
            <p class="subtle">{t("No description provided.")}</p>
          )
        }
      </GlassCard>
    </div>
  </div>

  <div slot="right">
    {
      similar.length > 0 && (
        <div class="section">
          <div class="container">
            <SectionHeading title={t("Related recipes")} />
            <Cards className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
              {similar
                .map((e) => e as any)
                .map(({ slug, name, description, stars, icon }) => (
                  <li class="inline-flex pt-2">
                    <Card
                      small
                      lang={lang}
                      slug={slug}
                      name={name}
                      description={description}
                      url={url(`/recipes/${slug}`)}
                      icon={icon}
                      stars={stars}
                    />
                  </li>
                ))}
            </Cards>
          </div>
        </div>
      )
    }

    {/* A reader who made it past the README has finished evaluating; give them
        the action again rather than the footer. */}
    <div class="section relative overflow-hidden mb-0">
      <div class="container">
        <div
          class="relative flex flex-col items-center gap-6 text-center py-16 rounded-pui-xl overflow-hidden"
        >
          <Aurora blobs={[{ color: brandGlow, x: 50, y: 90, size: 60 }]} />
          <h2
            class="relative z-10 m-0"
            set:html={t("Ready to run *{name}*?", { name })}
          />
          <div class="relative z-10">
            <StackActions
              lang={lang}
              runHref={url(`/recipes/${slug}.stack`)}
              fileHref={`/downloads/recipes/${slug}.stack`}
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .stack-ingredients {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
      gap: 0.75rem;
      padding: 0;
      list-style: none;
    }
    .stack-ingredients__item {
      display: flex;
      align-items: flex-start;
      gap: 0.875rem;
      height: 100%;
      padding: 1rem;
      border: 1px solid var(--pui-border);
      border-radius: var(--pui-radius-lg);
      background: var(--pui-glass-soft);
      color: inherit;
      transition:
        border-color 0.15s var(--pui-ease),
        background-color 0.15s var(--pui-ease);
    }
    a.stack-ingredients__item:hover {
      border-color: var(--pui-border-bright, var(--pui-border));
      background: var(--pui-overlay);
    }
    .stack-ingredients__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 2.25rem;
      height: 2.25rem;
      font-size: 1.125rem;
      border-radius: var(--pui-radius);
      border: 1px solid var(--pui-border);
      background: var(--pui-bg-elev);
      color: var(--brand);
    }
    .stack-ingredients__monogram {
      font-weight: 700;
      font-size: 0.9375rem;
      line-height: 1;
    }
    .stack-ingredients__name {
      display: block;
      font-weight: 600;
      line-height: 1.3;
    }
    /* The role is why the ingredient is in the recipe — the one thing worth
       reading in the whole row. */
    .stack-ingredients__role {
      display: block;
      margin-top: 0.25rem;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--pui-fg-mute);
    }

    /* READMEs are written for a repository page, where the first thing is
       usually a full-bleed screenshot. Unconstrained, it pushed the actual
       feature list a full viewport below the fold.

       The global `.content img` rule forces `width: 100%`, which is what made
       capping the height letterbox the image instead of shrinking it, so the
       width goes back to intrinsic here. */
    .stack-readme :global(img) {
      width: auto;
      max-width: 100%;
      max-height: 22rem;
      height: auto;
      border: 1px solid var(--pui-border);
    }
    /* Prose measure. The card is as wide as the page; running text should not
       be. Tables, images and code keep the full width. */
    .stack-readme :global(p),
    .stack-readme :global(li) {
      max-width: 72ch;
    }
  </style>
</Layout>
