---
import RunStatus from "~/components/RunStatus.astro";
import StackHero from "~/components/StackHero.astro";
import StackRunner from "~/components/StackRunner.astro";
import { langs, useTranslations, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";
import { getRecipes } from "~content/collections/recipes";

export const getStaticPaths = async () => {
  return langs
    .map((lang) =>
      getRecipes(lang).map(({ data }) => ({
        params: { lang, slug: data.slug },
      }))
    )
    .flat();
};

const slug = Astro.params.slug;
if (!slug) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return new Response("Missing parameter", { status: 404 });
}
const lang = Astro.params.lang;
const recipe = getRecipes(lang).find(
  (recipe) => recipe.data.slug === slug
)?.data;
if (!recipe) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return new Response("Not found", { status: 404 });
}

const t = useTranslations(lang);
const url = useUrl(lang);

const webUrl = `https://${slug}.stack.localhost`;

// TODO: hand off to the desktop app over `stack://` once the scheme is
// registered on every platform. Until then, an unconnected visitor gets the
// file.
const redirectUrl = `/downloads/recipes/${slug}.stack`;

const { name, version, env } = recipe;
---

<Layout lang={lang} leftTransition="fade">
  <div slot="left">
    <StackHero
      lang={lang}
      stack={recipe}
      eyebrow={t("Recipe")}
      spec={false}
      alternatives={false}
    >
      <RunStatus
        lang={lang}
        name={name}
        version={version}
        webUrl={webUrl}
        backHref={url(`/recipes/${slug}`)}
      />
    </StackHero>
  </div>

  <StackRunner
    lang={lang}
    name={name}
    version={version}
    webUrl={webUrl}
    redirectUrl={redirectUrl}
    env={env}
  />
</Layout>
