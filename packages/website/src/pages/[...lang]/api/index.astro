---
import { Aurora, GlassCard } from "performative-ui";
import SectionHeading from "~/components/SectionHeading.astro";
import Tag from "~/components/Tag.astro";
import { langs, languages, useTranslations, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";

export const getStaticPaths = () => {
  return langs.map((lang) => ({ params: { lang } }));
};

const lang = Astro.params.lang;
const t = useTranslations(lang);
const url = useUrl(lang);

const title = t("The best of free software, accessible");
const description = t(
  "Access {count}+ curated open source software packages, ready to install with one click.",
  { count: Math.floor([].length / 10) * 10 }
);
---

<Layout
  lang={lang}
  title={title}
  description={description}
  mainClass="left-only"
>
  <div slot="left" class="section h-full">
    <div class="container relative">
      <Aurora
        className="pointer-events-none"
        blobs={[
          { color: "rgba(6,182,212,0.30)", x: 25, y: 25, size: 55 },
          { color: "rgba(124,58,237,0.26)", x: 70, y: 60, size: 45 },
        ]}
      />
      <div class="relative z-10">
        <h1 set:html={t("Start exploring stacks programmatically.")} />
        <p
          class="subtle text-lg leading-relaxed"
          set:html={t(
            "We got you covered with every stacks and recipes, over API."
          )}
        />
      </div>
    </div>
  </div>

  <div class="section">
    <div class="container">
      <SectionHeading title={t("API specification")} />
      <div class="pui-grid">
        <GlassCard breathing glowOnHover>
          <GlassCard.Icon>📐</GlassCard.Icon>
          <GlassCard.Title>OpenAPI</GlassCard.Title>
          <GlassCard.Body>{t("API specification")}</GlassCard.Body>
          <GlassCard.Link
            href="/api/stack.openapi.yaml"
            className="stretched-link font-mono"
          >
            /api/stack.openapi.yaml
          </GlassCard.Link>
        </GlassCard>
      </div>

      <SectionHeading class="mt-16" title={t("API endpoints")} />
      <div class="pui-grid">
        {
          [
            { path: "/api/recipes", href: url("/api/recipes"), icon: "🧪" },
            { path: "/api/stacks", href: url("/api/stacks"), icon: "📦" },
            {
              path: "/api/stack/:slug",
              href: url("/api/stack/activepieces"),
              icon: "🔎",
            },
          ].map(({ path, href, icon }) => (
            <GlassCard breathing glowOnHover>
              <GlassCard.Icon>{icon}</GlassCard.Icon>
              <GlassCard.Title className="font-mono !text-base">
                {path}
              </GlassCard.Title>
              <GlassCard.Link href={href} className="stretched-link">
                GET
              </GlassCard.Link>
            </GlassCard>
          ))
        }
      </div>

      <SectionHeading class="mt-16" title={t("Localized endpoints")} />
      <div class="pui-grid">
        {
          Object.entries(languages).map(([langCode, langName]) => {
            const localized = (path: string) =>
              url(`/api${path}`, langCode as keyof typeof languages);

            return (
              <GlassCard breathing>
                <GlassCard.Title className="!text-base">
                  {langName} <Tag>{langCode}</Tag>
                </GlassCard.Title>
                <div class="flex flex-col gap-1 font-mono text-sm">
                  <a href={localized("/recipes")}>{localized("/recipes")}</a>
                  <a href={localized("/stacks")}>{localized("/stacks")}</a>
                </div>
              </GlassCard>
            );
          })
        }
      </div>
    </div>
  </div>
</Layout>
