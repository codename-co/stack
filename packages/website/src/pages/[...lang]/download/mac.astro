---
import { getLatestRelease } from "~/helpers/release";
import { langs, useTranslations } from "~/i18n";
import Layout from "~/layouts/Layout.astro";

export const getStaticPaths = () => {
  return langs.map((lang) => ({ params: { lang } }));
};

const lang = Astro.params.lang;
const t = useTranslations(lang);

// Resolved from the GitHub API at build time rather than from the version in
// tauri.conf.json: that version is bumped in the commit *before* the release
// exists, so deriving the asset URL from it hands visitors a 404 for as long as
// the release workflow is still running.
// Universal build: one DMG that runs natively on both Apple Silicon and Intel.
const release = await getLatestRelease();
const redirectUrl = release.dmgUrl;
---

<Layout lang={lang}>
  <meta http-equiv="refresh" content={`1;url=${redirectUrl}`} />

  <div class="section">
    <div class="container">
      <h1 set:html={t("Downloading Stack for {os}…", { os: "mac" })} />

      <h2 set:html={t("Once the download is complete")} />
      <ol>
        <li
          set:html={t(
            "Install the Stack app by double-clicking the downloaded file. Then drag it to your Applications folder."
          )}
        />
        <li set:html={t("Run the Stack app from your Applications folder.")} />
      </ol>

      <p>
        <a href={redirectUrl} rel="noopener">
          {
            release.resolved
              ? `Stack ${release.version} — macOS (universal)`
              : "Download from GitHub Releases"
          }
        </a>
      </p>
    </div>
  </div>
</Layout>
