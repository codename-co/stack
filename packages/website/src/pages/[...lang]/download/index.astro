---
import Download from "~/components/download.html";
import Logo from "~/components/Logo";
import { langs, useTranslations, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";

export const getStaticPaths = () => {
  return langs.map((lang) => ({ params: { lang } }));
};

const lang = Astro.params.lang;
const t = useTranslations(lang);
const url = useUrl(lang);

const title = t("Download Stack");

// The CTA is rendered for macOS and re-pointed client-side to whatever the
// visitor is actually running: the page is static, so the detection cannot
// happen at build time, and macOS is the most common visitor by far.
const platforms = [
  {
    id: "mac",
    name: "macOS",
    logo: "apple",
    href: url("/download/mac"),
    requirement: t("Requires {os} {version} or later", {
      os: "macOS",
      version: "11 Big Sur",
    }),
  },
  {
    id: "linux",
    name: "Linux",
    logo: "linux",
    href: url("/download/linux"),
    requirement: t("Requires a 64-bit Linux distribution with WebKitGTK 4.1"),
  },
  {
    id: "windows",
    name: "Windows",
    logo: "microsoft",
    href: url("/download/windows"),
    requirement: t("Requires {os} {version} or later", {
      os: "Windows",
      version: "10",
    }),
  },
] as const;

const detection = platforms.map(({ id, name, href, requirement }) => ({
  id,
  label: t("Download for {os}", { os: name }),
  href,
  requirement,
}));
---

<Layout lang={lang} title={title} leftTransition="fade">
  <div slot="left" class="section h-full">
    <div class="container">
      <h1 set:html={t("The *best free software* made&nbsp;*accessible*.")} />
      <p class="subtle mb-8" style="max-width: 24em">
        {t("Spin up local alternatives to")}
        <a
          href={url("/alternativesto/notion")}
          aria-label="Alternatives to Notion"
          style="white-space: nowrap"
        >
          <Logo slug="notion" />
          Notion</a
        >, <a
          href={url("/alternativesto/chatgpt")}
          aria-label="Alternatives to ChatGPT"
          style="white-space: nowrap"
        >
          <Logo slug="chatgpt" />
          ChatGPT</a
        >, <a
          href={url("/alternativesto/figma")}
          aria-label="Alternatives to Figma"
          style="white-space: nowrap"
        >
          <Logo slug="figma" />
          Figma</a
        >
        {t("and other")}
        <a
          href={url("/alternativesto")}
          aria-label="Alternatives to popular software"
          >{t("popular software")}</a
        >. {t("Remix your own.")}
      </p>
    </div>
  </div>

  <div class="section">
    <div class="container">
      <h2 set:html={t("Download Stack")} />
      <p
        class="subtle mb-8"
        set:html={t(
          "Give your desktop *superpowers*.<br />Make it run any open source quality software in a snap."
        )}
      />
      <a
        href={platforms[0].href}
        class="inline-flex highlight hover:animate-highlight"
        data-download-cta
      >
        <Download set:html={t("Download for {os}", { os: "macOS" })} />
      </a>
      <p class="subtle my-3" style="max-width: 24em">
        <small data-download-requirement set:html={platforms[0].requirement} />
      </p>
      <br />
      <div style="columns: 3; max-width: 15em">
        {
          platforms.map(({ id, name, logo, href }) => (
            <a
              href={href}
              data-platform-tile={id}
              class="flex cursor-pointer flex-col items-center rounded-lg px-6 py-2 hover:bg-neutral-100 hover:dark:bg-neutral-700"
              style="flex-direction: column;"
            >
              <Logo slug={logo} style={{ color: "inherit" }} />
              <span class="text-sm">{name}</span>
            </a>
          ))
        }
      </div>

      <script is:inline define:vars={{ detection }}>
        (() => {
          const ua = navigator.userAgent;
          const id = /Windows|Win64|Win32/i.test(ua)
            ? "windows"
            : // iPadOS reports as a Mac; both should be offered the DMG rather
              // than the Linux packages, so Linux is matched last and narrowly.
              /Mac|iPhone|iPad|iPod/i.test(ua)
              ? "mac"
              : /Linux|X11|CrOS/i.test(ua)
                ? "linux"
                : null;

          const platform = detection.find((p) => p.id === id);
          if (!platform) return;

          const cta = document.querySelector("[data-download-cta]");
          if (cta) {
            cta.href = platform.href;
            const label = cta.querySelector("span");
            if (label) label.textContent = platform.label;
          }

          const requirement = document.querySelector(
            "[data-download-requirement]"
          );
          if (requirement) requirement.innerHTML = platform.requirement;

          const tile = document.querySelector(
            `[data-platform-tile="${platform.id}"]`
          );
          if (tile) tile.classList.add("bg-neutral-100", "dark:bg-neutral-700");
        })();
      </script>
    </div>
  </div>
</Layout>
