---
import { GlassCard } from "performative-ui";
import Logo from "~/components/Logo";
import Pitch from "~/components/Pitch.astro";
import PuiButton from "~/components/PuiButton.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import { langs, useTranslations, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";

export const getStaticPaths = () => {
  return langs.map((lang) => ({ params: { lang } }));
};

const lang = Astro.params.lang;
const t = useTranslations(lang);
const url = useUrl(lang);

const title = t("Download Stack");

// The CTA is rendered for macOS and re-pointed client-side to whatever the
// visitor is actually running: the page is static, so the detection cannot
// happen at build time, and macOS is the most common visitor by far.
const platforms = [
  {
    id: "mac",
    name: "macOS",
    logo: "apple",
    href: url("/download/mac"),
    requirement: t("Requires {os} {version} or later", {
      os: "macOS",
      version: "11 Big Sur",
    }),
  },
  {
    id: "linux",
    name: "Linux",
    logo: "linux",
    href: url("/download/linux"),
    requirement: t("Requires a 64-bit Linux distribution with WebKitGTK 4.1"),
  },
  {
    id: "windows",
    name: "Windows",
    logo: "microsoft",
    href: url("/download/windows"),
    requirement: t("Requires {os} {version} or later", {
      os: "Windows",
      version: "10",
    }),
  },
] as const;

const detection = platforms.map(({ id, name, href, requirement }) => ({
  id,
  label: t("Download for {os}", { os: name }),
  href,
  requirement,
}));
---

<Layout lang={lang} title={title} leftTransition="fade">
  <div slot="left" class="section h-full">
    <div class="container">
      <Pitch lang={lang} aurora />
    </div>
  </div>

  <div class="section">
    <div class="container">
      <SectionHeading
        title={t("Download Stack")}
        subtitle={t(
          "Give your desktop *superpowers*.<br />Make it run any open source quality software in a snap."
        )}
      />

      <PuiButton
        href={platforms[0].href}
        variant="glow"
        size="lg"
        sparkle
        glyph="download"
        data-download-cta
      >
        <span
          data-download-label
          set:html={t("Download for {os}", { os: "macOS" })}
        />
      </PuiButton>

      <p class="subtle my-3" style="max-width: 24em">
        <small data-download-requirement set:html={platforms[0].requirement} />
      </p>
      <br />

      <div class="pui-grid">
        {
          platforms.map(({ id, name, logo, href, requirement }) => (
            <GlassCard
              breathing
              glowOnHover
              className="h-full"
              data-platform-tile={id}
            >
              <GlassCard.Icon>
                <Logo slug={logo} style={{ color: "inherit" }} />
              </GlassCard.Icon>
              <GlassCard.Title>{name}</GlassCard.Title>
              <GlassCard.Body>
                <Fragment set:html={requirement} />
              </GlassCard.Body>
              <GlassCard.Link href={href} className="stretched-link">
                <span set:html={t("Download for {os}", { os: name })} /> ↓
              </GlassCard.Link>
            </GlassCard>
          ))
        }
      </div>

      <script is:inline define:vars={{ detection }}>
        (() => {
          const ua = navigator.userAgent;
          const id = /Windows|Win64|Win32/i.test(ua)
            ? "windows"
            : // iPadOS reports as a Mac; both should be offered the DMG rather
              // than the Linux packages, so Linux is matched last and narrowly.
              /Mac|iPhone|iPad|iPod/i.test(ua)
              ? "mac"
              : /Linux|X11|CrOS/i.test(ua)
                ? "linux"
                : null;

          const platform = detection.find((p) => p.id === id);
          if (!platform) return;

          const cta = document.querySelector("[data-download-cta]");
          if (cta) {
            cta.href = platform.href;
            const label = cta.querySelector("[data-download-label]");
            if (label) label.innerHTML = platform.label;
          }

          const requirement = document.querySelector(
            "[data-download-requirement]"
          );
          if (requirement) requirement.innerHTML = platform.requirement;

          const tile = document.querySelector(
            `[data-platform-tile="${platform.id}"]`
          );
          if (tile) {
            tile.style.borderColor = "var(--pui-grad-from)";
            tile.style.boxShadow = "var(--pui-glow)";
          }
        })();
      </script>
    </div>
  </div>
</Layout>
