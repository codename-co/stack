---
import RunStatus from "~/components/RunStatus.astro";
import StackHero from "~/components/StackHero.astro";
import StackRunner from "~/components/StackRunner.astro";
import { getStacks } from "~/content/collections/stacks";
import { langs, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";

export const getStaticPaths = () => {
  return langs
    .map((lang) =>
      getStacks(lang).map(({ data }) => ({ params: { lang, slug: data.slug } }))
    )
    .flat();
};

const slug = Astro.params.slug;
if (!slug) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return new Response("Missing parameter", { status: 404 });
}
const lang = Astro.params.lang;
const stack = getStacks(lang).find((stack) => stack.data.slug === slug)?.data;
if (!stack) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not found";
  return new Response("Not found", { status: 404 });
}

const url = useUrl(lang);

const webUrl = `https://${slug}.stack.localhost`;

// TODO: hand off to the desktop app over `stack://` once the scheme is
// registered on every platform. Until then, an unconnected visitor gets the
// file.
const redirectUrl = `/downloads/${slug}.stack`;

const { name, version, env } = stack;
---

<Layout lang={lang} leftTransition="fade">
  {/*
    Same header as `/<slug>`, from the same component, so the navigation
    between the two morphs instead of repainting. It used to be `hidden
    2xl:block` here — below 1536px the page you arrived from simply vanished,
    which is the least smooth thing a transition can do.
  */}
  <div slot="left">
    {/* No spec list and no "alternative to" chips here: both answer "is this
        the thing I want, and should I run it?". You already decided. */}
    <StackHero lang={lang} stack={stack} spec={false} alternatives={false}>
      <RunStatus
        lang={lang}
        name={name}
        version={version}
        webUrl={webUrl}
        backHref={url(`/${slug}`)}
      />
    </StackHero>
  </div>

  <StackRunner
    lang={lang}
    name={name}
    version={version}
    webUrl={webUrl}
    redirectUrl={redirectUrl}
    env={env}
  />
</Layout>
