---
import { getCollection } from "astro:content";
import { Aurora, GlassCard } from "performative-ui";
import Logo from "~/components/Logo";
import SectionHeading from "~/components/SectionHeading.astro";
import Tag from "~/components/Tag.astro";
import { WallOfTags } from "~/components/WallOfTags";
import { logoFromIcon } from "~/components/Logo";
import { getStacks } from "~/content/collections/stacks";
import { langs, useTranslations, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";

export const getStaticPaths = () => {
  return langs.map((lang) => ({ params: { lang } }));
};

const lang = Astro.params.lang;
const t = useTranslations(lang);
const url = useUrl(lang);

const stacks = getStacks(lang);

const alternatives = await getCollection("alternatives");

const tags = (await getCollection("tags")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const title = t("Alternatives to popular software");
---

<Layout lang={lang} title={title}>
  <div slot="left" class="section">
    <div class="container relative">
      <Aurora
        className="pointer-events-none"
        blobs={[
          { color: "rgba(124,58,237,0.35)", x: 20, y: 25, size: 55 },
          { color: "rgba(6,182,212,0.22)", x: 65, y: 60, size: 45 },
        ]}
      />
      <div class="relative z-10">
        <h1 set:html={t("The open source ecosystem is *awe-inspiring*.")} />
        <p
          class="subtle text-lg leading-relaxed"
          set:html={t(
            "The community has created numerous high-quality, open source alternatives to popular software. Discover our curated list of amazing alternatives below."
          )}
        />
      </div>
    </div>
  </div>

  <div class="section">
    <div class="container">
      <div class="box" style="overflow-x: hidden">
        <SectionHeading title={t("Recognize these *popular software*?")} />

        <WallOfTags
          client:visible
          items={alternatives.map(({ data }) => {
            const logo = logoFromIcon({ slug: data.slug, icon: data.icon });
            return {
              slug: data.slug,
              name: data.name,
              url: url(`/alternativesto/${data.slug}`),
              ...(logo && typeof logo === "object" && { svg: logo.svg }),
            };
          })}
        />
      </div>

      <div class="box" style="overflow-x: hidden">
        <SectionHeading
          title={t("You'll love their *open source counterparts*")}
        />

        <WallOfTags
          client:visible
          rowCount={5}
          items={stacks.map(({ data }) => {
            const logo = logoFromIcon({ slug: data.slug, icon: data.icon });
            return {
              slug: data.slug,
              name: data.name,
              url: url(`/${data.slug}`),
              ...(logo && typeof logo === "object" && { svg: logo.svg }),
            };
          })}
        />
      </div>
    </div>
  </div>

  <div class="section">
    <div class="container">
      <SectionHeading
        eyebrow={t("Catalog")}
        title={t("Kinda *popular software* and their open counterparts")}
      />
      <div class="sm:columns-2 md:columns-3">
        {
          alternatives
            .sort()
            .map(({ data }) => data)
            .map(({ slug, name }) => (
              <>
                <div class="mb-4">
                  <a href={url(`/alternativesto/${slug}`)}>
                    <Logo slug={slug} />
                    &nbsp;{name}
                  </a>
                </div>
                <div class="mb-4 ml-2 border-l-2 pl-4 border-dotted border-pui-border rtl:ml-0 rtl:mr-2 rtl:pl-0 rtl:pr-4 rtl:border-l-0 rtl:border-r-2">
                  {stacks
                    .map(({ data }) => data)
                    .filter(({ alternativeTo }) =>
                      alternativeTo?.includes(slug)
                    )
                    .map(({ slug, name }) => (
                      <div class="mb-2">
                        <a
                          href={url(`/${slug}`)}
                          class="flex rtl:flex-direction-row-reverse"
                        >
                          <Logo slug={slug} />
                          &nbsp;{name}
                        </a>
                      </div>
                    ))}
                </div>
              </>
            ))
        }
      </div>
    </div>
  </div>

  <div class="section">
    <div class="container">
      <SectionHeading title={t("Browse *by category*")} />
      <ol class="light sm:columns-2 md:columns-2 lg:columns-3">
        {
          tags.map(({ data: { slug, name, title } }) => (
            <li class="mb-2">
              <a href={url(`/?q=%23${slug}`)}>
                {title ? `${title} (${name})` : name}
              </a>
              <Tag>
                {
                  stacks
                    .map(({ data }) => data)
                    .filter(({ tags }) => tags?.includes(slug)).length
                }
              </Tag>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Layout>
