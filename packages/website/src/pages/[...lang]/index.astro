---
import { getCollection } from "astro:content";
import { Aurora, CommunityBadge } from "performative-ui";
import { AlternativesMarquee } from "~/components/AlternativesMarquee";
import { StackSearch } from "~/components/StackSearch";
import { StarCounter } from "~/components/StarCounter";
import PuiButton from "~/components/PuiButton.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import { getStacks } from "~/content/collections/stacks";
import { langs, useTranslations, useUrl } from "~/i18n";
import Layout from "~/layouts/Layout.astro";
import { formatStars, getAlternativeMetadata } from "~/helpers";
import Card from "~components/Card";
import Cards from "~components/Cards";
import Logo from "~/components/Logo";
import { getRecipes } from "~content/collections/recipes";

export const getStaticPaths = () => {
  return langs.map((lang) => ({ params: { lang } }));
};

const lang = Astro.params.lang;
const t = useTranslations(lang);
const url = useUrl(lang);

const stacks = getStacks(lang);
const recipes = getRecipes(lang);
const promoted = await getCollection("promoted");
const staffPickSlugs = new Set(
  promoted.map(({ data }) => data.slug)
);

const alternatives = await getCollection("alternatives");

const totalStars = stacks.reduce(
  (acc, stack) => acc + (stack.data.stars ?? 0),
  0
);

const roundedCount = Math.floor(stacks.length / 10) * 10;

// Split the translated sentence around its number so the count can animate
// without inventing a second, counter-shaped translation key.
const [starsBefore, starsAfter] = t("★ {starCount} cumulative stars", {
  starCount: "\u0000",
}).split("\u0000");

// The marquee doubles as social proof: these are the products people are
// leaving, ranked by how much community weight their replacements carry.
const saasStars = new Map<string, number>();
for (const { data } of stacks) {
  for (const alt of data.alternativeTo ?? []) {
    saasStars.set(alt, (saasStars.get(alt) ?? 0) + (data.stars ?? 0));
  }
}
const marqueeItems = [...saasStars.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 24)
  .map(([slug]) => ({
    slug,
    name: getAlternativeMetadata(slug)?.name ?? slug,
    url: url(`/alternativesto/${slug}`),
  }));

const title = t("The best of free software, accessible");
const description = t(
  "Access {count}+ curated open source software packages, ready to install with one click.",
  { count: roundedCount }
);
---

<Layout lang={lang} title={title} description={description}>
  <div class="section relative">
    <AlternativesMarquee items={marqueeItems} />
    <Aurora
      className="pointer-events-none"
      blobs={[
        { color: "rgba(124,58,237,0.40)", x: 15, y: 20, size: 55 },
        { color: "rgba(236,72,153,0.28)", x: 70, y: 10, size: 45 },
        { color: "rgba(6,182,212,0.24)", x: 40, y: 70, size: 50 },
      ]}
    />
    <div class="container">
      <div class="relative overflow-hidden">
        <div class="relative z-10">
          <SectionHeading
            align="center"
            eyebrow={t("Recognize these *popular software*?")}
            title={t("You'll love their *open source counterparts*")}
          />
          <p class="suptitle text-center mt-0">
            <span set:html={starsBefore} /><StarCounter
              client:visible
              target={totalStars}
              lang={lang}
            /><span set:html={starsAfter} />
          </p>

          <div class="flex flex-col items-center gap-3 my-8">
            <PuiButton
              href={url("/download")}
              aria-label={t("Download Stack")}
              variant="glow"
              size="lg"
              glyph="download"
              sparkle
            >
              {t("Download")}
            </PuiButton>
            <p class="subtle m-0">
              <small>{t("Available for macOS, Windows and Linux")}</small>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section relative">
    <div class="container">
      <div id="catalog" class="sticky top-8 z-20">
        <StackSearch
          client:load
          targetId="stacks"
          placeholder={t("Search software")}
        />
      </div>
      <br />
      <Cards
        id="stacks"
        className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3"
      >
        {
          [...stacks, ...recipes]
            .map(({ data }) => data)
            .map(
              ({
                type,
                slug,
                name,
                description,
                icon,
                updated_at,
                tags: _tags,
                stars,
                alternativeTo,
              }) => (
                <li
                  class="inline-flex pt-2"
                  data-search={(function() {
                    const searchTags = _tags?.map((tag) => `#${tag}`).join(",") || "";
                    const searchAlts = alternativeTo?.map((slug) => getAlternativeMetadata(slug)?.name).join(",") || "";
                    return searchTags + "," + searchAlts;
                  })()}
                >
                  <Card
                    lang={lang}
                    slug={slug}
                    name={name}
                    description={description}
                    url={
                      type === "recipe"
                        ? url(`/recipes/${slug}`)
                        : url(`/${slug}`)
                    }
                    icon={icon}
                    stars={stars}
                    updated_at={updated_at}
                    breathing={false}
                    mentionHtml={
                      (alternativeTo?.length ?? 0) > 0
                        ? `<span class="text-[10px] leading-none px-1 py-0.5">${t("a smart alternative to {apps}", {
                            apps: alternativeTo
                              ?.map((slug) => [slug, Logo({ slug }) as any])
                              .map(
                                ([slug, { props }]) =>
                                  (props?.dangerouslySetInnerHTML?.__html || "") +
                                  alternatives.find(({ data }) => data.slug === slug)?.data.name
                              )
                              .join(", "),
                          })}</span>`
                        : undefined
                    }}
                  />
                </li>
              )
            )
        }
      </Cards>
    </div>
  </div>

  <div class="section relative overflow-hidden mb-0">
    <div class="container">
      <div
        class="relative text-center flex flex-col items-center gap-8 py-20 rounded-pui-xl overflow-hidden"
      >
        <Aurora
          blobs={[{ color: "rgba(124,58,237,0.55)", x: 50, y: 90, size: 60 }]}
        />
        <h2
          class="relative z-10 m-0"
          set:html={t("The *best free software* made&nbsp;*accessible*.")}
        />
        <div class="relative z-10 flex flex-wrap gap-4 justify-center">
          <PuiButton
            href={url("/download")}
            variant="glow"
            size="lg"
            sparkle
            glyph="download"
          >
            {t("Download Stack")}
          </PuiButton>
          <CommunityBadge
            href="https://github.com/codename-co/stack"
            title="GitHub"
            subtitle={`★ ${formatStars(totalStars, lang)}`}
            iconNode={Logo({ slug: "github" })}
          />
        </div>
      </div>
    </div>
  </div>

  <style>
    @media (width >= 40rem) {
      li:hover .absolute {
        opacity: 0.6;
      }
    }
  </style>
</Layout>
