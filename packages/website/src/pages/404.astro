---
import { Aurora, GradientText, WibblingSpinner } from "performative-ui";
import PuiButton from "~/components/PuiButton.astro";
import { getLatestRelease } from "~/helpers/release";
import Layout from "~/layouts/Layout.astro";

// GitHub Pages serves this file (with a 404 status) for any unknown path.
//
// It matters most for `/releases/...`: the site used to host the DMGs itself,
// so links like `/releases/Stack_0.2.1_aarch64.dmg` are still in the wild — in
// old blog posts, in chat history, in the release notes of old builds. Pages
// has no rewrite rules, so instead of a dead end we recognise those URLs
// client-side and send the visitor to the current release.
const release = await getLatestRelease();

// Old links carry the file extension of what they wanted, which is enough to
// send the visitor to the equivalent artifact of the current release.
const byExtension = Object.fromEntries(
  release.artifacts.map((a) => [a.id, a.url])
);
---

<Layout title="Not found">
  <div class="section relative">
    <div class="container relative py-16 text-center">
      <Aurora
        className="pointer-events-none"
        blobs={[{ color: "rgba(236,72,153,0.35)", x: 50, y: 30, size: 60 }]}
      />
      <div class="relative z-10 flex flex-col items-center gap-6">
        <h1 class="m-0">
          <GradientText>404</GradientText>
        </h1>

        <p id="generic" class="subtle text-lg">
          The page you asked for does not exist. Try the
          <a href="/">home page</a>, <a href="/recipes">the recipes</a> or
          <a href="/download">the download page</a>.
        </p>

        <p id="release" hidden class="subtle text-lg">
          <WibblingSpinner client:load /> Downloads have moved to GitHub Releases.
          Taking you to the latest version…
        </p>

        <PuiButton
          href="/download"
          rel="noopener"
          variant="glow"
          size="lg"
          sparkle
          glyph="download"
        >
          {
            release.resolved
              ? `Download Stack ${release.version}`
              : "Download the latest Stack release"
          }
        </PuiButton>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ byExtension, htmlUrl: release.htmlUrl }}>
  // A stale download link is a visitor who wants a binary, not an apology.
  if (location.pathname.startsWith("/releases/")) {
    document.getElementById("generic")?.setAttribute("hidden", "");
    document.getElementById("release")?.removeAttribute("hidden");
    // A known installer extension means "give me the file"; anything else
    // under /releases/ (an updater manifest probe, a directory listing) is
    // better served by the release page itself.
    const ext = /\.(dmg|exe|msi|AppImage|deb|rpm)$/i.exec(location.pathname);
    const target =
      (ext && byExtension[ext[1].toLowerCase()]) ||
      // `.tar.gz`/`.zip` are the macOS updater bundles: the DMG is what a
      // human clicking such a link actually wants.
      (/\.(tar\.gz|zip)$/.test(location.pathname) && byExtension.dmg) ||
      htmlUrl;
    setTimeout(() => location.replace(target), 1500);
  }
</script>
