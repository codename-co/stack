---
import { Sparkle } from "performative-ui";
import { getLangFromUrl, useTranslations, useUrl } from "~/i18n";
import { LanguagePicker } from "./LanguagePicker";
import { DarkModeSwitcher } from "./DarkModeSwitcher";

const currentLang = getLangFromUrl(Astro.url);

const t = useTranslations(currentLang);
const url = useUrl(currentLang);
---

<nav
  id="navbar"
  class="flex items-center justify-between flex-wrap w-full mx-auto select-none py-4"
>
  <div class="flex gap-8 items-center flex-shrink-0">
    <a class="flex items-center" href={url("/")}>
      <img src="/128x128.png" alt="" width="32" height="32" class="mr-2" />
      <span class="font-extrabold text-xl tracking-tight text-pui-fg">
        Stack
      </span>
    </a>

    <div class="hidden gap-6 font-medium sm:flex text-sm">
      <a href={url("/alternativesto")}>{t("Catalog")}</a>
      <a href={url("/recipes")}>{t("Recipes")}</a>
    </div>
  </div>

  <div class="flex items-center text-base gap-3">
    <DarkModeSwitcher client:load />
    <LanguagePicker client:only="react" currentUrl={Astro.url} />
  </div>
</nav>
